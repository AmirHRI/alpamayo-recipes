# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
# (venvs already self-ignore via their own .gitignore, but be explicit)
a1_sft/
a1_5_sft/
a1_5_eval/
# no trailing slash: also catches a `.venv` that's a symlink (e.g. to a
# differently-named venv dir), which a `.venv/`-style pattern won't match
.venv
**/.venv
venv/
env/

# ---- Training / experiment artifacts ----
outputs/
outputs/*
output_*/
output_stage*
training/
wandb/
*.log
*.ckpt
*.safetensors
*.pt
*.bin

# ---- Local data / caches ----
.cache/
*.tmp
tea_debug.log

# ---- Secrets / env ----
.env
.env.*

# ---- OS / editor ----
.DS_Store
Thumbs.db

# Reference papers kept alongside recipes (binary, not source)
recipes/**/*.pdf
